# ═══════════════════════════════════════════════════════════════════
# SocialPilot Environment Configuration
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════════

APP_NAME=SocialPilot
ENVIRONMENT=production
DEBUG=False

# ── Database ────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://socialpilot:socialpilot_secret@postgres:5432/socialpilot_db
# SQLite (development - this is the default if DATABASE_URL is not set)
# DATABASE_URL=sqlite:///./socialpilot.db

# ── Redis & Celery (optional - APScheduler is used by default) ─────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Security & JWT ──────────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-strong-random-secret-key-here-socialpilot-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── URLs ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# ── Google Authentication (Login with Google) ──────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Scopes: openid, email, profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ══════════════════════════════════════════════════════════════════
# Social Platform API Credentials
# Leave empty to use demo (simulated) mode for development
# ══════════════════════════════════════════════════════════════════

# ── Facebook ────────────────────────────────────────────────────────
# App: https://developers.facebook.com/
# Required permissions: pages_manage_posts, pages_read_engagement, pages_show_list
# OAuth callback: http://localhost:8000/social-accounts/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Instagram ───────────────────────────────────────────────────────
# Uses Facebook Graph API with instagram_content_publish permission
# Requires an Instagram Professional (Business or Creator) account linked to a Facebook Page
# Instagram account_id = the Instagram Business Account ID
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── LinkedIn ────────────────────────────────────────────────────────
# App: https://www.linkedin.com/developers/
# Required products: Sign In with LinkedIn using OpenID Connect, Share on LinkedIn
# Required permissions/scopes: w_member_social, openid, profile, email
# OAuth callback: http://localhost:8000/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/callback
LINKEDIN_SCOPES=w_member_social openid profile email

# ── Twitter / X ─────────────────────────────────────────────────────
# App: https://developer.twitter.com/s
# Required permissions: tweet.read, tweet.write, users.read, offline.access (OAuth 2.0 PKCE)
# OAuth callback: http://localhost:8000/social-accounts/oauth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
# Optional OAuth 1.0a credentials
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── YouTube / Google Data API v3 ────────────────────────────────────
# App: https://console.cloud.google.com/
# Required API: YouTube Data API v3
# Required scope: https://www.googleapis.com/auth/youtube.upload
# OAuth callback: http://localhost:8000/social-accounts/oauth/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/social-accounts/oauth/youtube/callback

# ── Pinterest ───────────────────────────────────────────────────────
# App: https://developers.pinterest.com/
# Required scopes: pins:read, pins:write, boards:read, boards:write
# OAuth callback: http://localhost:8000/social-accounts/oauth/pinterest/callback
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8000/social-accounts/oauth/pinterest/callback

# ══════════════════════════════════════════════════════════════════
# IMPORTANT NOTES
# ══════════════════════════════════════════════════════════════════
# - Never commit the actual .env file to version control
# - When credentials are not set, the system uses demo providers
# - Demo providers simulate publishing without real API calls
# - Real providers require approved apps on each platform
# ══════════════════════════════════════════════════════════════════
