# ═══════════════════════════════════════════════════════════════════
# SocialPilot Environment Configuration
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════════

APP_NAME=SocialPilot
ENVIRONMENT=production
DEBUG=False

# ── Database ────────────────────────────────────────────────────────
# PostgreSQL (production)
DATABASE_URL=postgresql://socialpilot:socialpilot_secret@postgres:5432/socialpilot_db
# SQLite (development - this is the default if DATABASE_URL is not set)
# DATABASE_URL=sqlite:///./socialpilot.db

# ── Redis & Celery (optional - APScheduler is used by default) ─────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Security & JWT ──────────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-strong-random-secret-key-here-socialpilot-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── URLs ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# ══════════════════════════════════════════════════════════════════
# Social Platform API Credentials
# Leave empty to use demo (simulated) mode for development
# ══════════════════════════════════════════════════════════════════

# ── Facebook ────────────────────────────────────────────────────────
# App: https://developers.facebook.com/
# Required permissions: pages_manage_posts, pages_read_engagement
# OAuth callback: http://localhost:8000/social-accounts/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── Instagram ───────────────────────────────────────────────────────
# Uses Facebook Graph API with instagram_content_publish permission
# Requires an Instagram Business or Creator account linked to a Facebook Page
# Instagram account_id = the Instagram Business Account ID (NOT the IG user ID)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── LinkedIn ────────────────────────────────────────────────────────
# App: https://www.linkedin.com/developers/
# Required permissions: w_member_social, r_liteprofile, r_emailaddress
# OAuth callback: http://localhost:8000/social-accounts/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Twitter / X ─────────────────────────────────────────────────────
# App: https://developer.twitter.com/
# Required permissions: tweet.read, tweet.write, users.read, offline.access
# OAuth callback: http://localhost:8000/social-accounts/oauth/twitter/callback
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_BEARER_TOKEN=
# OAuth 1.0a (for older API methods if needed)
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── YouTube / Google ────────────────────────────────────────────────
# App: https://console.cloud.google.com/
# Required: YouTube Data API v3, OAuth consent screen
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ══════════════════════════════════════════════════════════════════
# IMPORTANT NOTES
# ══════════════════════════════════════════════════════════════════
# - Never commit the actual .env file to version control
# - When credentials are not set, the system uses demo providers
# - Demo providers simulate publishing without real API calls
# - Real providers require approved apps on each platform
# ══════════════════════════════════════════════════════════════════
