# Add settings to your existing Backend/.env; never replace its database/JWT settings.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_KEY=
# Set the Graph API version supported by your Meta developer app, e.g. vNN.0.
META_GRAPH_VERSION=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/oauth/facebook/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/oauth/instagram/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/oauth/linkedin/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/oauth/x/callback
# YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/oauth/youtube/callback
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_MAX_MB=1024
# LinkedIn API version (YYYYMM) and optional extra scopes once approved
LINKEDIN_VERSION=202607
LINKEDIN_EXTRA_SCOPES=
# Minimum minutes between X metric refreshes per post (X tiers allow few reads)
X_METRICS_MINUTES=360
