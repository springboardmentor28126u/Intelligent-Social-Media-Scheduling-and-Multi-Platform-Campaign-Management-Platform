# Configure these in your hosting provider's environment settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
CORS_ORIGINS=https://your-frontend.example.com
JWT_SECRET_KEY=
# Preserve the existing key when migrating encrypted social account credentials.
SOCIAL_TOKEN_KEY=
# Copy the applicable OAuth settings from .env.social.example and replace
# localhost callback URLs with your public HTTPS backend URL.
# MongoDB is optional; the application's main records use PostgreSQL.
# MONGO_URI=
# MONGO_DB=
