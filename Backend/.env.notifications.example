# Add these to Backend/.env or the hosting provider's secret settings.
# Delivery is opt-in for each user and runs in notification_worker.py.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
# VAPID keys must be a matching pair. Never expose the private key.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:your-admin@example.com
